// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  university_id    String       @id @unique
  username         String
  password         String
  points           Int
  profile_image    String?
  isAdmin          Boolean      @default(false)
  isVolunteer      Boolean      @default(false)
  isWishVolunteer  Boolean      @default(false)
  
  // Relations
  user_events      UserEvent[]
  badges           Badge[]
  
  @@map("users")
}

model Event {
  id              Int          @id @default(autoincrement())
  title           String
  description     String
  date            DateTime     @db.Date
  fromTime        DateTime     @db.Time()
  toTime          DateTime     @db.Time()
  eventVenue      String
  banner_image    String?
  isSoftDelete    Boolean      @default(false)
  points          Int          @default(50)
  
  // Relations
  user_events     UserEvent[]
  
  @@map("events")
}

model UserEvent {
  user_id         String
  event_id        Int
  points          Int
  isParticipated  Boolean      @default(false)
  
  // Relations
  user            User         @relation(fields: [user_id], references: [university_id])
  event           Event        @relation(fields: [event_id], references: [id])
  
  @@id([user_id, event_id])
  @@map("user_event")
}

model Notification {
  id              Int          @id @default(autoincrement())
  title           String
  time            DateTime     @db.Time()
  message         String
  isRead          Boolean      @default(false)
  
  @@map("notifications")
}

model Badge {
  id              Int          @id @default(autoincrement())
  user_id         String
  title           String
  
  // Relations
  user            User         @relation(fields: [user_id], references: [university_id])
  
  @@map("badges")
}